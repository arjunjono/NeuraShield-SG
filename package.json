{
  "name": "neurashield-sg",
  "version": "1.0.0",
  "description": "Checks a chat for Singapore scam scripts and grooming, entirely in the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "eval": "esbuild src/lib/detectionEngine.js --bundle --format=esm --platform=neutral --outfile=evaluation/.engine.mjs --log-level=warning && node evaluation/eval.mjs",
    "stress": "esbuild src/lib/detectionEngine.js --bundle --format=esm --platform=neutral --outfile=evaluation/.engine.mjs --log-level=warning && node evaluation/stress.mjs",
    "build:single": "vite build --config vite.single.config.js",
    "postinstall": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
